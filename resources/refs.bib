@article{mata_carbon-nutrient_2012,
	title = {Carbon-nutrient balance in relation to biomass production and halogenated compound content in the red alga \textit{{Asparagopsis} taxiformis} ({Bonnemaisoniaceae})},
	volume = {48},
	issn = {0022-3646, 1529-8817},
	url = {https://doi.org/10.1111/j.1529-8817.2011.01083.x},
	abstract = {We tested how the availability of carbon and nitrogen determines both the production of Asparagopsis taxiformis (Delile) V. Trevis. and content of the two major halocarbons, bromoform and dibromoacetic acid. The halogenated secondary metabolites of Asparagopsis species are particularly interesting from an applied perspective due to their remarkable antimicrobial activity. Terrestrial ecologists named the relationship between resources and secondary metabolites as the carbon (C)/nutrient balance (CNB) hypothesis. This relationship was tested both in the laboratory, with a factorial analysis using different concentrations of total ammonia (TAN) and dissolved inorganic carbon (DIC), and in an integrated aquaculture system where TAN and DIC fluxes of fish effluent were manipulated. The total C/N content of A. taxiformis biomass cultivated in laboratory was highly significantly linearly related to the content of both halocarbons, as predicted by the CNB hypothesis. A. taxiformis cultivated at low levels of carbon and high levels of nitrogen (N) (lowest C/N ratio) had the lowest content in both halogenated metabolites. Increased availability of CO2 in the medium resulted in a general higher halocarbon content in the biomass, even though the effect was only statistically significant for bromoform at high levels of N. The farm experiments supported the results of the laboratory experiments. DIC fluxes had the highest effect on the production of both bromoform and biomass, as shown by multiple regression analysis. In A. taxiformis integrated aquaculture, C, rather than N, is the most important factor affecting the production of biomass and of valuable halocarbon secondary metabolites.},
	language = {en},
	number = {1},
	urldate = {2025-01-10},
	journal = {Journal of Phycology},
	author = {Mata, Leonardo and Gaspar, Helena and Santos, Rui},
	month = feb,
	year = {2012},
	keywords = {Asparagopsis, Asparagopsis taxiformis},
	pages = {248--253},
	file = {Mata et al. 2012 - Carbon-nutrient balance in relation to biomass pro.pdf:C\:\\Users\\treimer\\OneDrive - University of Tasmania\\Zotero\\Mata et al. 2012 - Carbon-nutrient balance in relation to biomass pro.pdf:application/pdf},
}

@techreport{su_barra-c2_2024,
	address = {Australia},
	title = {{BARRA}-{C2}: {Development} of the kilometre-scale downscaled atmospheric reanalysis over {Australia}},
	abstract = {The Bureau of Meteorology has produced a convective-scale reanalysis over Australia 
providing a higher resolution addition to the second version of the Bureau's Atmospheric 
Regional Reanalysis for Australia (BARRA2). This {\textasciitilde}4 km reanalysis, BARRA-C2, is 
downscaled from its {\textasciitilde}12 km parent system BARRA-R2, to better represent orography 
and storm-scale processes. 
The system configuration is described in detail in this report, although more information 
on BARRA2 can be found in the report on BARRA-R2 (Su, Rennie, et al., 2022). Here 
we describe the developments specific to regional model physics configurations and land 
cover description options. Verification of BARRA-C2 against various observations is 
provided in the context of comparing different physics configurations, as well as 
comparing with BARRA-R2 and ERA5 (ECMWF Reanalysis v5). This verification is 
broken down by various climatological regions around Australia. As BARRA-C2 is a 
downscaled system, spin-up is an important consideration, so the justification for the 
allowed spin-up period is presented. 
The final configuration of BARRA-C2 is evaluated in comparison to BARRA-R2 to show 
its benefits and how it complements its parent reanalysis. BARRA-C2 demonstrates 
improved representation of severe storms and localised precipitation accumulation, in 
comparison with observations that capture storm scales, such as radar. BARRA-C2 can 
capture severe wind gusts and other localised storm impacts more accurately than 
BARRA-R2, as depicted in several selected case studies. BARRA-C2 can provide real 
information on attributes of large storms whilst BARRA-R2 can only provide information 
on their environments. The combined analyses presented here show the potential added 
benefit of the convective-scale reanalysis. Fundamental limitations of BARRA-C2 as a 
downscaling system remain, highlighting the needs for major development of convective
scale reanalysis in future iterations to better meet climate monitoring requirements for 
high-impact weather events and extremes.},
	language = {en},
	number = {097},
	institution = {Bureau of Meteorology},
	author = {Su, Chun-Hsu and Rennie, Susan and Torrance, Joshua and Howard, Emma and Stassen, Christian and Lipson, Mathew and Warren, Rob and Pepler, Acacia and Dharssi, Imtiaz and Franklin, Charmaine},
	month = aug,
	year = {2024},
	pages = {71},
	file = {Su et al. 2024 - BARRA-C2 Development of the kilometre-scale downs.pdf:C\:\\Users\\treimer\\OneDrive - University of Tasmania\\Zotero\\Su et al. 2024 - BARRA-C2 Development of the kilometre-scale downs.pdf:application/pdf},
}

