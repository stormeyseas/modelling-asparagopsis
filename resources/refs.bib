}

@article{carayo_correlation_2008,
	title = {Correlation of inorganic nutrients to the standing crop of “green tide” algae during the peak growth season in eastern {Mactan} island, central {Philippines}},
	volume = {42},
	url = {https://doi.org/10.3860/psci.v42i0.357},
	abstract = {Water samples were analyzed for nitrate and phosphate concentrations to determine if there was a strong correlation with green tide biomass at four intertidal sites in eastern Mactan, central Philippines. The study was conducted from March to May 2004-the known peak growth season of species causing green tide, and a hot dry season in the study areas. In all stations, the dominant species causing green tide was Ulva reticulata. There was a significant difference in Ulva biomass among study sites and time periods. As for both nitrate and phosphate, there was no significant difference among sites but showed significant effect with respect to time period, suggesting that temporal variation could be the main factor affecting the concentration of inorganic nutrients. The relatively high nutrient concentration in March could have led to the increase of green tide algal biomass. Nitrate and phosphate concentrations appear to have a better correlation with green tide biomass than the nitrate:phosphate ratio. The ni-trate:phosphate ratio showed no clear pattern or consistency among sites.},
	journal = {The Philippine Scientist},
	author = {Carayo, Charmaine and Culango, Kathleen and Estrera, Diomedes and Largo, Danilo and Dy, Danilo},
	month = jul,
	year = {2008},
