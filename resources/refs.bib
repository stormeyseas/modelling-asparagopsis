	journal = {Fisheries science},
	author = {Kakinuma, Makoto and Kuno, Yoshinao and Amano, Hideomi},
	year = {2004},
	keywords = {Ulva, Chlorophyta, free amino acid, photosynthetic pigment, proline, salinity stress, stress response},
	pages = {1177--1179},
