}

@article{massocato_growth_2022,
	title = {Growth, biofiltration and photosynthetic performance of {Ulva} spp. cultivated in fishpond effluents: {An} outdoor study},
	volume = {9},
	issn = {2296-7745},
	shorttitle = {Growth, biofiltration and photosynthetic performance of {Ulva} spp. cultivated in fishpond effluents},
	url = {https://doi.org/10.3389/fmars.2022.981468},
	abstract = {Anthropogenic impacts on water resources, especially by ​​nutrient discharge, is a worldwide problem in marine coastal areas. In this context, seaweed cultivation in aquaculture wastewater can be considered as an alternative for effluent mitigation, where the biomass becomes a source of valuable compounds. The current study examined the potential use of the seaweeds \textit{Ulva pseudorotundata} and \textit{Ulva rigida} to remove nutrients to treat effluents from the culture of \textit{Chelon labrosus}. Two experiments were conducted under pilot-scale conditions to evaluate the nutrient uptake, photosynthetic activity, and biomass production of the seaweed species cultivated under 50 and 100\% effluent concentrations. Photosynthetic parameters were determined by \textit{in vivo} chlorophyll \textit{a} fluorescence associated to photosystem II 3 times a day to estimate photosynthetic performance and seaweed physiology throughout the experiment: optimal quantum yield ({\textless}italic{\textgreater}F{\textless}/italic{\textgreater}$_{\textrm{v}}${\textless}italic{\textgreater}/F{\textless}/italic{\textgreater}$_{\textrm{m}}$), {\textless}italic{\textgreater}in situ{\textless}/italic{\textgreater} and {\textless}italic{\textgreater}ex situ{\textless}/italic{\textgreater} electron transport rate (ETR), photosynthetic efficiency (α$_{\textrm{ETR}}$), saturation irradiance ({\textless}italic{\textgreater}E{\textless}/italic{\textgreater}$_{\textrm{k}}$), and the maximum non-photochemical quenching (NPQ$_{\textrm{max}}$). To evaluate seaweed metabolism and biomass compounds, elemental and biochemical composition were analyzed in the beginning and end of each experiment. Results regarding the nutrient source showed that both species removed more than 65\% of ammonium after 3 hours of experimentation. At the end of the experiments, up to 94.8\% of the initial ammonium was sequestered from the effluent. Additionally, after 5 days of cultivation under 50\% fish effluent both {\textless}italic{\textgreater}Ulva{\textless}/italic{\textgreater} species were able to remove more than 85\% of the nitrate. Although a decrease in uptake efficiency was observed in cultures with 100\% fish effluent, at the end of the experiment more than 440 µmol L$^{\textrm{-1}}$ of nitrate was removed, considering all treatment conditions. The biomass values showed that growth rates of seaweed cultivated in 100\% effluent were higher than those obtained in 50\% effluent. Moreover, when cultivated in the 100\% effluent concentration, a significant increment in protein content was detected in both {\textless}italic{\textgreater}Ulva{\textless}/italic{\textgreater} species. Our results contribute to the understanding of biofiltration and photosynthetic performance of two different {\textless}italic{\textgreater}Ulva{\textless}/italic{\textgreater} species in order to improve growth optimization, enhancement of biofiltration capacity and also to boost management practices of seaweed cultivation in aquaculture effluent treatment systems.{\textless}/p{\textgreater}},
	language = {English},
	urldate = {2024-10-29},
	journal = {Frontiers in Marine Science},
	author = {Massocato, Thaís Fávero and Robles-Carnero, Víctor and Moreira, Bruna Rodrigues and Castro-Varela, Pablo and Pinheiro-Silva, Lorena and Oliveira, Willian da Silva and Vega, Julia and Avilés, Antonio and Bonomi-Barufi, José and Rörig, Leonardo Rubi and Figueroa, Félix L.},
	month = sep,
	year = {2022},
	note = {Publisher: Frontiers},
	keywords = {Photosynthesis, Ulva, Aquaculture, Nitrogen, biofiltration, in vivo chlorophyll-a fluorescence},
	file = {Massocato et al. 2022 - Growth, biofiltration and photosynthetic performan.pdf:C\:\\Users\\treimer\\OneDrive - University of Tasmania\\Zotero\\Massocato et al. 2022 - Growth, biofiltration and photosynthetic performan.pdf:application/pdf},
}

@techreport{strain_storm_2023,
