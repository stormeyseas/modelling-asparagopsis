	author = {Msuya, Flower E. and Neori, Amir},
	month = dec,
	year = {2008},
	keywords = {Ulva, Environmental Chemistry, Agitation treatment, Fishpond effluents, Nutrient uptake, Seaweed biofiltration, Water movement, Yield},
	pages = {1021--1031},
