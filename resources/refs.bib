@phdthesis{batista_reproduction_2020,
	address = {Faro, Portugal},
	type = {Master's {Degree} in {Aquaculture} and {Fisheries}},
	title = {Reproduction {And} {Cultivation} {Of} \textit{{Asparagopsis} {Taxiformis}} ({Delile}) {Trevisan}},
	url = {https://www.proquest.com/openview/901a5f50ec7fd5303892e9e152ddbd29/1?cbl=2026366&diss=y&pq-origsite=gscholar&parentSessionId=y0Perhwl9mpqmTALdu6%2B9WZD9OV3eNVwVehuJvGs1Rg%3D},
	abstract = {Seaweeds have been receiving increased interest from the fisheries and  aquaculture industries in recent years, with red algae continuing to be one of the more  important components of seaweed aquaculture representing 54\% of the harvested biomass  (around US\$ 6.3 billion). These seaweeds are important for both food and diverse of  biotechnology usages. Asparagopsis taxiformis, a characteristic red alga, has been  receiving increased attention for its biotechnological applications, the most interesting  one being its ability to reduce methane emissions on the cattle. A. taxiformis presents a  triphasic life history, passing from gametophyte to carposporophyte and finally to  tetrasporophyte. The conditions for the lab manipulation and survival of this species are  still not know, taking in consideration the difficulty of maintaining gametophyte cultures.  In this work, some abiotic factors affecting gametophyte maintenance and  reproduction were experimentally tested. A. taxiformis gametophyte did not survive any  common pretreatment used, only surviving in culture if cleaned of epizoa in sterilized  filtered seawater and by selecting the less epiphyted individuals. A. taxiformis showed the  highest growth rate when cultivated at 15 oC, not growing at 20 oC and dying at 25 oC.  An industrial fertilizer used showed similar growth rates compared to the Von Stosch  medium. Photoperiod manipulation did not result in any sexual differentiation on the  gametophytes. A low stock density (1 g/L) was required since at higher densities there  was reduced (2 g/L) or no (4g/L) growth rate. A. taxiformis was able to grow at both 20  and 40 μmol photon m-2 s-1, showing slightly higher (but not significant) growth rates at  the latter. Attempts at inducing carposporophyte formation were unsuccessful.  Temperature and light intensity were the two most important factors to maintain  gametophyte culture.},
	language = {en},
	urldate = {2024-09-01},
	school = {Universidade do Algarve},
	author = {Batista, Miguel Melo},
	year = {2020},
	file = {Batista 2020 - Reproduction And Cultivation Of Asparagopsis Ta.pdf:C\:\\Users\\treimer\\OneDrive - University of Tasmania\\Zotero\\Batista 2020 - Reproduction And Cultivation Of Asparagopsis Ta.pdf:application/pdf},
}

@phdthesis{mickelson_defining_2013,
	address = {Hilo, Hawai'i},
	type = {Master of {Science}},
	title = {Defining culture requirements for reproduction and growth of \textit{ {Asparagopsis} taxiformis,} a {Hawaiian} native red alga - {ProQuest}},
	url = {https://www.proquest.com/openview/0520e85744e5eb91218e87776fccfdf3/1?pq-origsite=gscholar&cbl=18750},
	abstract = {Asparagopsis taxiformis, a widely distributed tropical-subtropical red seaweed (Rhodophyta,  order Bonnemaisoniales), is native to the Hawaiian Islands. This species is highly valued as a  food condiment in Hawaiʻi because of its pungent flavor. Asparagopsis taxiformis has high  concentrations of halogenated secondary metabolites with antibacterial and antiviral activity that  may have powerful medicinal value. Although a related species in Portugal, A. armata, is being  successfully grown in tank culture, little is known about the biotic and abiotic conditions needed  by A. taxiformis to progress through each life phase. This project tested culture conditions that  promote growth and reproduction of each life phase of A. taxiformis.  Tetrasporophyte growth was highest at 24 μmol photons m-2 s-1 when cultured in half strength  PES media at 21-23°C, 12L:12D, under cool white fluorescent bulbs. Gametophytes did not  survive in flask culture under any of the conditions tested due to contamination, although  isolation of apical tips using agar was effective in beginning unialgal gametophyte petri dish  culture. Optimal conditions for inducing carpospore release involved immersing fertile female  thalli in filtered seawater in complete darkness for 16 hours, at 21-23°C. Peak spore release  occurred four hours after fluorescent lights came on. Germination rates were similar when  spores were grown in both f/2 and PES media. Analysis of historic spatial and temporal  distribution of herbaria specimens indicated that gametophytes grow on both leeward and  windward coasts of Hawaiʻi, during both wet and dry seasons. Phenological data suggested that  laboratory conditions probably play a bigger role in carpospore release and germination than the  environmental parameters observed in the four weeks antecedent to collection. This research reveals that a unialgal culture of A. taxiformis may be begun from wild-collected gametophyte  thalli, and grown successfully in culture through at least part of its life cycle.},
	language = {en},
	urldate = {2024-09-02},
	school = {University of Hawai„i},
	author = {Mickelson, Aaron},
	year = {2013},
	keywords = {Asparagopsis, Asparagopsis taxiformis},
	file = {Mickelson 2013 - Defining culture requirements for reproduction and.pdf:C\:\\Users\\treimer\\OneDrive - University of Tasmania\\Zotero\\Mickelson 2013 - Defining culture requirements for reproduction and.pdf:application/pdf},
}

@article{guiry_daylength_1992,
	title = {Daylength, temperature and nutrient control of tetrasporogenesis in \textit{{Asparagopsis} armata} ({Rhodophyta})},
	volume = {158},
	issn = {0022-0981},
	url = {https://doi.org/10.1016/0022-0981(92)90227-2},
	abstract = {The formation of tetrasporangia in Falkenbergia-phase tetrasporophytes of Asparagopsis armata Harvey (Rhodophyta : Bonnemaisoniales) isolated from introduced populations in Ireland and Italy, and from native populations in Victoria, Australia, was examined in temperature-controlled water-baths at 2°C intervals from 11–23°C and at 1- or 0.5-h daylength intervals from 8–12 h. At a daylength of 8 h, Irish plants formed tetrasporangia only at (15-)17(−21)°C, Italian plants at 17–21dgC and Australian plants at 13–17°C. However, after an incubation period of 5 wk, only the Italian consistently showed 100\% reproduction under these conditions. At 17°C, the critical daylength for tetrasporogensis is 8–9 h for the Irish and Australian strains and 9–10 h for the Italian strain. These results indicate that all three isolates differ in their response to environmental variables. It is likely that the Mediterranean and Irish populations thus represent separate introductions into the Northern Hemisphere and that Australia was not the source of these plants. The abundance of gametophytes of this species at Messina, Sicily, in April and May is explained by a reproductive “window” of daylength and temperature for tetrasporogenesis from mid-November to late January. In Victoria, Australia, temperatures are inductive all year but daylength at the water surface is never {\textless}9.5 h. However, it is considered that tidal ranges of 2–3 m cause the effective daylength in winter to fall below the inductive threshold. In northern Europe, the restricted geographical distribution of gametophytes is probably determined by tidally and/or topographically induced shorter daylengths in late October and November, and also by higher temperatures in the intertidal on warm days. Previously reported responses to N and P levels in enriched seawater media were not confirmed and may have resulted from incubation at suboptimal temperatures. Arsenic and iodine supplementation appears to be necessary for reproduction only in the Irish strain.},
	number = {2},
	urldate = {2024-09-02},
	journal = {Journal of Experimental Marine Biology and Ecology},
	author = {Guiry, Michael D. and Dawes, Clinton J.},
	month = jun,
	year = {1992},
	keywords = {-phase, Control of reproduction, Daylength and temperature effects, Introduced seaweed, Nutrient effect},
	pages = {197--217},
	file = {Guiry and Dawes 1992 - Daylength, temperature and nutrient control of tet.pdf:C\:\\Users\\treimer\\OneDrive - University of Tasmania\\Zotero\\Guiry and Dawes 1992 - Daylength, temperature and nutrient control of tet.pdf:application/pdf},
}

